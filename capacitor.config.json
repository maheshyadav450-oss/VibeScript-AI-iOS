{
  "appId": "com.vibescriptai.app",
  "appName": "VibeScript AI",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0B0B0F"
  },
  "ios": {
    "backgroundColor": "#0B0B0F",
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0B0B0F",
      "showSpinner": false
    }
  }
}
